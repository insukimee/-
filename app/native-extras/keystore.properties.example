# Copy to android/keystore.properties (gitignored) after you create a keystore
# outside the repository. Do not commit the keystore or the passwords.
#
#   keytool -genkeypair -v \
#     -keystore ~/us-market-insight-upload.keystore \
#     -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ directory.
storeFile=../path-outside-the-repo/upload.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
